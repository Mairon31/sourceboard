{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "rootDirs": [".", "./.react-router/types"],
    "types": ["vite/client"],
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": [
    ".react-router/types/**/*",
    "app/**/*",
    "worker/**/*",
    "shared/**/*",
    "tests/**/*",
    "worker-configuration.d.ts",
    "*.ts"
  ]
}
