{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourceboard",
  "main": "./worker/app.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sourceboard-db",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sourceboard-media",
      "remote": false,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "sourceboard-events",
        "remote": false,
      },
    ],
    "consumers": [
      {
        "queue": "sourceboard-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
      },
    ],
  },
  "env": {
    "ssr": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sourceboard-db",
          "migrations_dir": "migrations",
          "remote": false,
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "sourceboard-media",
          "remote": false,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "remote": false,
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS",
            "queue": "sourceboard-events",
            "remote": false,
          },
        ],
      },
      "send_email": [
        {
          "name": "EMAIL",
          "remote": false,
        },
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "",
      },
      "secrets": {
        "required": [
          "TURNSTILE_SECRET",
          "EMAIL_FROM",
          "EMAIL_LOOKUP_KEY_V1",
          "DATA_ENCRYPTION_KEY_V1",
        ],
      },
    },
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false,
    },
  ],
  "vars": {
    // The real public Turnstile site key is supplied during provisioning.
    // The empty value keeps local type generation deterministic without
    // pretending that a site has already been registered.
    "TURNSTILE_SITE_KEY": "",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "EMAIL_FROM", "EMAIL_LOOKUP_KEY_V1", "DATA_ENCRYPTION_KEY_V1"],
  },
}
