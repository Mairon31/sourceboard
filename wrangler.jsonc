{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sourceboard",
  "main": "./worker/app.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sourceboard-db",
      "database_id": "564bfc61-254e-4e65-9972-81501df8a818",
      "migrations_dir": "migrations",
      "remote": false,
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "sourceboard-media",
      "remote": false,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "89293be6800349788e686eb988fc22f2",
      "remote": false,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "sourceboard-events",
        "remote": false,
      },
    ],
    "consumers": [
      {
        "queue": "sourceboard-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "sourceboard-events-dlq",
      },
    ],
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_AUTH",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_CONTENT",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_REACTIONS",
      "namespace_id": "1003",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_UPLOADS",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" }],
  },
  "migrations": [{ "tag": "notification-hub-v1", "new_sqlite_classes": ["NotificationHub"] }],
  "env": {
    "ssr": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sourceboard-db",
          "database_id": "564bfc61-254e-4e65-9972-81501df8a818",
          "migrations_dir": "migrations",
          "remote": false,
        },
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "sourceboard-media",
          "remote": false,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "89293be6800349788e686eb988fc22f2",
          "remote": false,
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "EVENTS",
            "queue": "sourceboard-events",
            "remote": false,
          },
        ],
        "consumers": [
          {
            "queue": "sourceboard-events",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "sourceboard-events-dlq",
          },
        ],
      },
      "durable_objects": {
        "bindings": [{ "name": "NOTIFICATION_HUB", "class_name": "NotificationHub" }],
      },
      "ratelimits": [
        {
          "name": "RATE_LIMIT_AUTH",
          "namespace_id": "1001",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_CONTENT",
          "namespace_id": "1002",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_REACTIONS",
          "namespace_id": "1003",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "RATE_LIMIT_UPLOADS",
          "namespace_id": "1004",
          "simple": { "limit": 20, "period": 60 },
        },
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "remote": false,
        },
      ],
      "vars": {
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEqlOpm_bo6ovKs5",
      },
      "secrets": {
        "required": [
          "TURNSTILE_SECRET",
          "EMAIL_FROM",
          "EMAIL_LOOKUP_KEY_V1",
          "DATA_ENCRYPTION_KEY_V1",
        ],
      },
    },
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": false,
    },
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEqlOpm_bo6ovKs5",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET", "EMAIL_FROM", "EMAIL_LOOKUP_KEY_V1", "DATA_ENCRYPTION_KEY_V1"],
  },
}
